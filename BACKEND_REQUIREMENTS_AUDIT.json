  "api_design": {
    "endpoints": [
      {
        "method": "POST",
        "path": "/api/contact",
        "description": "Submit contact form message",
        "request_body": {
          "name": "string (2-100 chars)",
          "email": "string (valid email)",
          "subject": "string (3-200 chars)",
          "message": "string (10-5000 chars)",
          "captcha": "string (optional, reCAPTCHA token)"
        },
        "response_success": {
          "status": 200,
          "body": {
            "success": true,
            "message": "Message sent successfully",
            "id": "uuid"
          }
        },
        "response_error": {
          "status": "400/422/429",
          "body": {
            "success": false,
            "error": "string",
            "details": "object (optional)"
          }
        },
        "rate_limit": "5 requests/hour per IP"
      },
      {
        "method": "POST",
        "path": "/api/bookings",
        "description": "Create a new booking request",
        "request_body": {
          "type": "video | phone | in-person",
          "date": "YYYY-MM-DD",
          "time": "HH:MM",
          "timezone": "string (IANA timezone)",
          "name": "string",
          "email": "string",
          "notes": "string (optional)"
        },
        "response_success": {
          "status": 201,
          "body": {
            "success": true,
            "booking": {
              "id": "uuid",
              "type": "string",
              "dateTime": "ISO timestamp",
              "meetingLink": "url",
              "confirmationSent": true
            }
          }
        },
        "rate_limit": "10 requests/hour per IP"
      },
      {
        "method": "GET",
        "path": "/api/availability",
        "description": "Get available time slots",
        "query_params": {
          "month": "YYYY-MM",
          "type": "video | phone | in-person (optional)"
        },
        "response_success": {
          "status": 200,
          "body": {
            "slots": [
              {
                "date": "YYYY-MM-DD",
                "times": [
                  { "time": "HH:MM", "available": true }
                ]
              }
            ]
          }
        },
        "rate_limit": "60 requests/hour per IP"
      },
      {
        "method": "POST",
        "path": "/api/generate-pdf",
        "description": "Generate PDF version of CV",
        "request_body": {
          "language": "en | de | fa",
          "focusFilter": "string",
          "sections": ["string"],
          "includeContact": "boolean",
          "includeReferences": "boolean"
        },
        "response_success": {
          "status": 200,
          "content_type": "application/pdf",
          "body": "binary PDF data"
        },
        "rate_limit": "20 requests/hour per IP"
      }
    ],
