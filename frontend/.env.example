# Environment Variables for CV Portfolio Website
# Copy this file to .env.local for local development
#
# All variables are OPTIONAL. The app works without any of them.
# Validation only fails for invalid values (e.g., bad URLs, out-of-range rates).

# =============================================================================
# OBSERVABILITY - Runtime UX Feedback
# These are OPTIONAL. Leaving them unset disables the corresponding tools.
# Both tools are disabled in development by default for privacy.
# =============================================================================

# Microsoft Clarity - Session Replays & Heatmaps
# Get your project ID from https://clarity.microsoft.com/
# Only enabled in production builds unless VITE_CLARITY_FORCE_ENABLE=true
VITE_CLARITY_ID=

# Force enable Clarity in development (for testing)
# VITE_CLARITY_FORCE_ENABLE=true

# Sentry - Error Tracking & Performance Monitoring
# Get your DSN from https://sentry.io/
# Only enabled in production builds unless VITE_SENTRY_FORCE_ENABLE=true
VITE_SENTRY_DSN=

# Force enable Sentry in development (for testing)
# VITE_SENTRY_FORCE_ENABLE=true

# Sentry release version (optional - set via CI/CD)
# VITE_SENTRY_RELEASE=

# Sentry performance traces sample rate (0.0 to 1.0, default: 0.1)
# Set to 0 to disable performance monitoring
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry session replay sample rate (0.0 to 1.0, default: 0)
# CAUTION: Session replays may capture sensitive data
# VITE_SENTRY_REPLAYS_SESSION_RATE=0

# Sentry error replay sample rate (0.0 to 1.0, default: 0)
# Captures replay when an error occurs
# VITE_SENTRY_REPLAYS_ERROR_RATE=0

# =============================================================================
# DEBUGGING & DEVELOPMENT
# =============================================================================

# Enable verbose debug logging for CV data loading
# Useful for debugging data normalization issues
# VITE_DEBUG_CV=true

# Enable pseudo-localization for i18n testing
# Transforms UI strings to identify missing translations
# Can also be enabled via URL param: ?pseudo=true
# VITE_PSEUDO_LOC=true

# =============================================================================
# DEPLOYMENT - Build-time configuration
# =============================================================================

# Base path for deployment (e.g., '/repo-name/' for GitHub Pages)
# Leave empty for root deployments (Vercel, Netlify, custom domains)
# VITE_BASE_PATH=/your-repo-name/
