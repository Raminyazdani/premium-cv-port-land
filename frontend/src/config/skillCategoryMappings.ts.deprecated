/**
 * Gets the canonical English key from a language-specific category key.
 * Returns the original key if no mapping is found.
 */
export function getCanonicalSkillCategoryKey(
  key: string, 
  sourceLang: 'en' | 'de' | 'fa',
  isTopCategory: boolean = true
): string {
  if (sourceLang === 'en') return key
  
  const mappings = isTopCategory ? SKILL_TOP_CATEGORY_MAPPINGS : SKILL_SUB_CATEGORY_MAPPINGS
  
  for (const [canonicalKey, mapping] of Object.entries(mappings)) {
    if (mapping[sourceLang] === key) {
      return canonicalKey
    }
  }
  
  // If no mapping found, return the original key
  return key
}

/**
 * Gets the display label for a skill category in the specified language.
 * Falls back to the canonical key if no display label is found.
 */
export function getSkillCategoryDisplayLabel(
  canonicalKey: string,
  targetLang: 'en' | 'de' | 'fa'
): string {
  const displayLabels = SKILL_CATEGORY_DISPLAY_LABELS[canonicalKey]
  if (displayLabels && displayLabels[targetLang]) {
    return displayLabels[targetLang]
  }
  
  // Fallback: use formatting helper for unknown keys
  return formatSkillCategoryForDisplay(canonicalKey)
}

/**
 * Formats a raw skill category key for display.
 * Replaces underscores with spaces and applies proper casing.
 */
export function formatSkillCategoryForDisplay(key: string): string {
  return key
    .replace(/_/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
}
