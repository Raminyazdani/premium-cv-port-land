/**
 * Skill Category Mappings
 * 
 * Maps DE/FA skill category keys to EN canonical keys.
 * This ensures consistent internal structure while preserving 
 * language-appropriate display labels.
 * 
 * Strategy: Keep canonical internal keys (EN) + attach per-language display names.
 */

export interface SkillCategoryMapping {
  en: string
  de: string
  fa: string
}

